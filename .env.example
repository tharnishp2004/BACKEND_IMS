# Local development defaults:
# MYSQLHOST=localhost
# MYSQLPORT=3306
# MYSQLDATABASE=inventory_db
# MYSQLUSER=root
# MYSQLPASSWORD=tiger
# PORT=8080
# Set this to a private random value of at least 32 characters:
# APP_JWT_SECRET=

# Railway Production:
# Connect the MySQL database service in Railway.
# Either reference Railway MySQL variables or supply MYSQL_URL:
# MYSQL_URL=${{MySQL.MYSQL_URL}}
